        <mxCell id="0EqYyl5Twokt_m04KWXX-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;从不规则事件流到规则多变时间序列的构造路径&lt;/font&gt;" vertex="1">
